# ──────────────────────────────────────────────────────────────────────
# SIGIL — environment configuration
#
# Copy this file to .env.local and fill in your key.
# .env.local is gitignored and must never be committed.
# ──────────────────────────────────────────────────────────────────────

# REQUIRED — your Google Gemini API key.
# Get one at https://aistudio.google.com/apikey
#
# This variable is read ONLY on the server (it has no NEXT_PUBLIC_ prefix),
# so it is never included in the browser bundle. All Gemini traffic goes
# through SIGIL's own /api/gemini/* route handlers.
GEMINI_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# Optional — model configuration
#
# These ARE exposed to the browser (they are only model names, never
# secrets) so the Settings page can show the active defaults.
# Anything set in Settings overrides these for that browser.
# ──────────────────────────────────────────────────────────────────────

# Fast structured work: the discovery interview.
NEXT_PUBLIC_GEMINI_TEXT_MODEL=gemini-3.8-flash

# Heavier reasoning: brand brief, creative directions, critique, iteration.
NEXT_PUBLIC_GEMINI_REASONING_MODEL=gemini-3.8-flash

# Exploration batches — dozens of images per run, so speed matters.
NEXT_PUBLIC_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Finalist lockups and delivery assets — fidelity matters more than speed.
NEXT_PUBLIC_GEMINI_FINALIST_IMAGE_MODEL=gemini-3-pro-image

# ──────────────────────────────────────────────────────────────────────
# Optional — generation defaults
# ──────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_BATCH_CONCURRENCY=3
NEXT_PUBLIC_MAX_RETRIES=2
NEXT_PUBLIC_DEFAULT_DIRECTIONS=8
NEXT_PUBLIC_DEFAULT_CONCEPTS_PER_DIRECTION=6
NEXT_PUBLIC_DEFAULT_ITERATIONS=4
NEXT_PUBLIC_IMAGE_ASPECT_RATIO=1:1

# ──────────────────────────────────────────────────────────────────────
# Optional — transport
# ──────────────────────────────────────────────────────────────────────

# Milliseconds before a single Gemini request is abandoned.
GEMINI_TIMEOUT_MS=180000

# Override only if you are proxying the Gemini API.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
